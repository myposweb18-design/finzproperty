# FinzProperty standalone production configuration
# Copy to .env, replace every placeholder, chmod 600 .env, and never commit .env.
PORT=3000

# Required: local or managed MySQL database.
DATABASE_URL=mysql://finzapp:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:3306/finzproperty

# Required by the current Manus OAuth/session integration.
# Obtain these from the authorized Manus project/configuration.
MANUS_PROJECT_ID=REPLACE_WITH_PROJECT_ID
MANUS_JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SESSION_SECRET
MANUS_OAUTH_API_URL=https://REPLACE_WITH_OAUTH_API_HOST
MANUS_OAUTH_PORTAL_URL=https://REPLACE_WITH_OAUTH_PORTAL_HOST

# Required by the current managed Google Maps proxy.
MANUS_API_URL=https://REPLACE_WITH_MANUS_API_HOST
MANUS_API_KEY=REPLACE_WITH_SERVER_API_KEY
MANUS_API_BROWSER_KEY=REPLACE_WITH_BROWSER_MAP_KEY

# Optional owner/admin mapping.
OWNER_OPEN_ID=

# Optional public hostname used by your reverse proxy/certificate.
PUBLIC_APP_URL=https://finzproperty.com
